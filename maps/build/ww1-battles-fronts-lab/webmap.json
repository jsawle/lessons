      "name": "when",
      "title": "When",
      "returnType": "string",
      "expression": "function fmt(d) {\n  if (IsEmpty(d)) { return ''; }\n  var t = TypeOf(d);\n  if (t == 'Date') { return Text(ToUTC(d), 'MMMM D, Y'); }\n  if (t == 'DateOnly') { return Text(d, 'MMMM D, Y'); }\n  var p = Split(d, '-');\n  var m = ['January','February','March','April','May','June','July','August','September','October','November','December'];\n  return m[Number(p[1]) - 1] + ' ' + Text(Number(p[2])) + ', ' + p[0];\n}\nfunction monthOf(d) {\n  var s = fmt(d); var parts = Split(s, ' ');\n  return parts[0] + ' ' + parts[2];\n}\nvar a = $feature.StartDate; var b = $feature.EndDate;\nif ($feature.DatePrecision == 'month') { var ma = monthOf(a); var mb = monthOf(b); return IIf(ma == mb, ma, ma + ' to ' + mb); }\nif ($feature.DatePrecision == 'approximate') { return 'About ' + fmt(a) + ' to ' + fmt(b); }\nvar fa = fmt(a); var fb = fmt(b);\nreturn IIf(fa == fb, fa, fa + ' to ' + fb);"
     },
     {
      "name": "src2",
      "title": "Second source",
      "returnType": "string",
      "expression": "return IIf(IsEmpty($feature.Source2), '', '; ' + $feature.Source2);"
     }
    ]
