    "expressionInfos": [
     {
      "name": "admitted",
      "title": "Admitted",
      "returnType": "string",
      "expression": "return IIf(IsEmpty($feature.Admitted), '', ' (a state from ' + $feature.Admitted + ')');"
     },
     {
      "name": "note",
      "title": "Note",
      "returnType": "string",
      "expression": "return DefaultValue($feature.Note, '');"
     },
     {
      "name": "status",
      "title": "Status in 1850",
      "returnType": "string",
      "expression": "// The legend groups Washington, D.C. with the slave states; a state's own pop-up says just 'Slave state'.\nvar s = $feature.Status1850;\nif ($feature.Kind == 'State' && Find('Slave state', s) == 0) { return 'Slave state'; }\nif ($feature.Kind == 'District') { return 'A federal district where slavery was legal'; }\nreturn s;"
     }
    ]
   }
