   "popupInfo": {
    "title": "{Name}",
    "popupElements": [
     {
      "type": "text",
      "text": "<p><b>{expression/status}</b></p><p>This border was in force from {expression/from} to {expression/to}.</p>"
     }
    ],
    "showAttachments": false,
    "fieldInfos": [],
    "expressionInfos": [
     {
      "name": "status",
      "title": "Status",
      "returnType": "string",
      "expression": "var s = $feature.Status;\nvar c = $feature.ControlledBy;\nif (c == 'Soviet Union') { c = 'the Soviet Union'; }\nif (c == 'United Kingdom') { c = 'the United Kingdom'; }\nif (c == 'United States, United Kingdom and France') { c = 'the United States, the United Kingdom and France'; }\nif (s == 'Independent') { return 'An independent country'; }\nif (s == 'Occupied') { return 'Occupied by ' + c; }\nif (s == 'Colony') { return 'A colony of ' + c; }\nif (s == 'Mandate') { return 'Under the protection of the ' + c; }\nreturn s;"
     },
     {
      "name": "from",
      "title": "Border in force from",
      "returnType": "string",
      "expression": "var d = $feature.BorderFrom;\nif (IsEmpty(d)) { return ''; }\nvar p = Split(d, '-');\nvar m = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nreturn m[Number(p[1]) - 1] + ' ' + Text(Number(p[2])) + ', ' + p[0];"
     },
     {
      "name": "to",
      "title": "Border in force to",
      "returnType": "string",
      "expression": "var d = $feature.BorderTo;\nif (IsEmpty(d)) { return ''; }\nvar p = Split(d, '-');\nvar m = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nif (p[0] == '2019') { return 'still in force when the source data ends (2019)'; }\nreturn m[Number(p[1]) - 1] + ' ' + Text(Number(p[2])) + ', ' + p[0];"
     }
    ]
   }
