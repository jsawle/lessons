      "title": "Seceded",
      "returnType": "string",
      "expression": "// The layer stores the date as midnight UTC, so it is read in UTC; otherwise US time zones show the day before.\nreturn IIf(IsEmpty($feature.Seceded), '', ' Seceded: ' + Text(ToUTC($feature.Seceded), 'MMMM D, Y') + '.');"
