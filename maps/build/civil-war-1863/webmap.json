  {
   "id": "lyrde52544663f",
   "title": "Civil War battlefields",
   "url": "https://services7.arcgis.com/iFGeGXTAJXnjq0YN/arcgis/rest/services/WASO_ABPP-NPS_Battlefield Boundaries UPDATE/FeatureServer/0",
   "itemId": "8b2e2d492c124d1cacba0599d20639ae",
   "layerType": "ArcGISFeatureLayer",
   "visibility": false,
   "opacity": 1,
   "layerDefinition": {
    "drawingInfo": {
     "renderer": {
      "type": "simple",
      "symbol": {
       "type": "esriSFS",
       "style": "esriSFSSolid",
       "color": [
        26,
        26,
        26,
        115
       ],
       "outline": {
        "type": "esriSLS",
        "style": "esriSLSSolid",
        "color": [
         26,
         26,
         26,
         255
        ],
        "width": 2.5
       }
      },
      "label": "Land where a battle was fought"
     }
    },
    "minScale": 0,
    "maxScale": 0
   },
   "popupInfo": {
    "title": "{expression/name}",
    "popupElements": [
     {
      "type": "text",
      "text": "<p>{expression/what}</p><p>The area mapped is about {expression/acres} acres.</p><p><i>{expression/note}</i></p>"
     }
    ],
    "showAttachments": false,
    "fieldInfos": [],
    "expressionInfos": [
     {
      "name": "name",
      "title": "Battle",
      "returnType": "string",
      "expression": "// The layer spells two names differently from the National Park Service's own usage.\nvar n = Proper(Lower($feature.NAME));\nn = Replace(n, 'Glorietta', 'Glorieta');\nn = Replace(n, 'St.phillip', 'St. Philip');\nreturn n;"
     },
     {
      "name": "acres",
      "title": "Acres",
      "returnType": "string",
      "expression": "return Text(Round($feature.Acres, -2), '#,###');"
     },
     {
      "name": "what",
      "title": "What happened here",
      "returnType": "string",
      "expression": "var st = Decode(Trim($feature.STATE), 'AL', 'Alabama', 'AR', 'Arkansas', 'CO', 'Colorado', 'DC', 'Washington, D.C.', 'FL', 'Florida', 'GA', 'Georgia', 'ID', 'Idaho', 'IN', 'Indiana', 'KS', 'Kansas', 'KY', 'Kentucky', 'LA', 'Louisiana', 'MD', 'Maryland', 'MN', 'Minnesota', 'MO', 'Missouri', 'MS', 'Mississippi', 'NC', 'North Carolina', 'ND', 'North Dakota', 'NM', 'New Mexico', 'OH', 'Ohio', 'OK', 'Oklahoma', 'PA', 'Pennsylvania', 'SC', 'South Carolina', 'TN', 'Tennessee', 'TX', 'Texas', 'VA', 'Virginia', 'WV', 'West Virginia', '');\nvar inSt = IIf(st == '', '', ' in ' + st);\nvar n = Upper(Trim($feature.NAME));\nif (n == 'SAND CREEK') { return 'The site of the Sand Creek Massacre,' + inSt + '. In November 1864 United States volunteer troops attacked a Cheyenne and Arapaho village here.'; }\nif (n == 'BEAR RIVER') { return 'The site of the Bear River Massacre,' + inSt + '. In January 1863 United States volunteer troops attacked a Northwestern Shoshone village here.'; }\nreturn 'A Civil War battlefield' + inSt + '.';"
     },
     {
      "name": "note",
      "title": "Note",
      "returnType": "string",
      "expression": "var n = Upper(Trim($feature.NAME));\nif (n == 'SAND CREEK' || n == 'BEAR RIVER') { return 'The National Park Service maps this area with its Civil War battlefields. It was an attack on a village, not a battle.'; }\nreturn 'The area is the land where the battle was fought, as mapped by the National Park Service. This layer does not say who won.';"
     }
    ]
   }
  }
