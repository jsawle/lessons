   "labels": {
    "expression": "$feature.Name",
    "placement": "polygon",
    "color": "#1A1A1A",
    "font": {
     "size": 9,
     "weight": "bold"
    },
    "halo": {
     "color": "#FFFFFFE6",
     "size": 1.5
    }
   },
   "popup": {
    "title": "{Name}",
    "html": "<p><b>{expression/status}</b></p><p>This border was in force from {expression/from} to {expression/to}.</p>",
    "expressions": {
     "status": {
      "title": "Status",
      "arcade": "var s = $feature.Status;\nvar c = $feature.ControlledBy;\nif (c == 'Soviet Union') { c = 'the Soviet Union'; }\nif (c == 'United Kingdom') { c = 'the United Kingdom'; }\nif (c == 'United States, United Kingdom and France') { c = 'the United States, the United Kingdom and France'; }\nif (s == 'Independent') { return 'An independent country'; }\nif (s == 'Occupied') { return 'Occupied by ' + c; }\nif (s == 'Colony') { return 'A colony of ' + c; }\nif (s == 'Mandate') { return 'Under the protection of the ' + c; }\nreturn s;"
     },
     "from": {
      "title": "Border in force from",
      "arcade": "var d = $feature.BorderFrom;\nif (IsEmpty(d)) { return ''; }\nvar p = Split(d, '-');\nvar m = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nreturn m[Number(p[1]) - 1] + ' ' + Text(Number(p[2])) + ', ' + p[0];"
     },
     "to": {
      "title": "Border in force to",
      "arcade": "var d = $feature.BorderTo;\nif (IsEmpty(d)) { return ''; }\nvar p = Split(d, '-');\nvar m = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nif (p[0] == '2019') { return 'still in force when the source data ends (2019)'; }\nreturn m[Number(p[1]) - 1] + ' ' + Text(Number(p[2])) + ', ' + p[0];"
     }
    }
   },
   "filter": "ShowFrom <= DATE '1924-12-31' AND ShowTo >= DATE '1914-01-01'"
  }
 ],
