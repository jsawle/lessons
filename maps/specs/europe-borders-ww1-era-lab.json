   "labels": {
    "expression": "'from ' + $feature.FromName",
    "placement": "polygon",
    "color": "#1A1A1A",
    "font": {
     "size": 8,
     "weight": "normal"
    },
    "halo": {
     "color": "#FFFFFFF2",
     "size": 1.5
    }
   },
   "popup": {
    "title": "{FromName} to {ToName}",
    "html": "<p>This land went from {expression/from} to {expression/to} on <b>{expression/date}</b>.</p><p>It covers about {AreaKm2} square kilometres.</p>",
    "fields": {
     "AreaKm2": {
      "places": 0,
      "digitSeparator": true
     }
    },
    "expressions": {
     "date": {
      "title": "Date",
      "arcade": "var d = $feature.ChangeDate;\nif (IsEmpty(d)) { return ''; }\nvar p = Split(d, '-');\nvar m = ['January','February','March','April','May','June','July','August','September','October','November','December'];\nreturn m[Number(p[1]) - 1] + ' ' + Text(Number(p[2])) + ', ' + p[0];"
     },
     "from": {
      "title": "From",
      "arcade": "var n = $feature.FromName;\nif (n == 'Soviet Union' || n == 'Russian Empire' || n == 'Ottoman Empire' || n == 'United Kingdom' || n == 'Irish Free State' || n == 'Free City of Danzig' || n == 'Kingdom of Serbs, Croats and Slovenes') { return 'the ' + n; }\nreturn n;"
     },
     "to": {
      "title": "To",
      "arcade": "var n = $feature.ToName;\nif (n == 'Soviet Union' || n == 'Russian Empire' || n == 'Ottoman Empire' || n == 'United Kingdom' || n == 'Irish Free State' || n == 'Free City of Danzig' || n == 'Kingdom of Serbs, Croats and Slovenes') { return 'the ' + n; }\nreturn n;"
     }
    }
   },
   "filter": "ShowFrom <= DATE '1924-12-31' AND ShowTo >= DATE '1914-01-01'"
  },
